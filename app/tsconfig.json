{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-native",
    "types": ["react-native", "node"]
  },
  "include": ["App.tsx", "src/**/*.ts"],
  "exclude": ["node_modules"]
}
